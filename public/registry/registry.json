{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "cracked0x-ui",
  "homepage": "https://ui.cracked0x.sh",
  "type": "registry:ui",
  "items": [
    {
      "name": "token-selector",
      "type": "registry:component",
      "title": "A token selector component",
      "description": "A evm-based multichain token selector",
      "dependencies": ["viem", "numeral"],
      "devDependencies": ["@types/numeral"],
      "registryDependencies": [
        "button",
        "dialog",
        "drawer",
        "command",
        "skeleton"
      ],
      "envVars": {
        "NEXT_PUBLIC_DUNE_API_KEY": "<DUNE_API_KEY>"
      },
      "files": [
        {
          "path": "registry/token-selector/components/token-selector/index.tsx",
          "type": "registry:component",
          "target": "src/components/token-selector/index.tsx"
        },
        {
          "path": "registry/token-selector/components/token-selector/token-list-item.tsx",
          "type": "registry:component",
          "target": "src/components/token-selector/token-list-item.tsx"
        },
        {
          "path": "registry/token-selector/components/token-selector/token-selection.tsx",
          "type": "registry:component",
          "target": "src/components/token-selector/token-selection.tsx"
        },
        {
          "path": "registry/token-selector/components/token-selector/chain-token-logo.tsx",
          "type": "registry:component",
          "target": "src/components/token-selector/chain-token-logo.tsx"
        },
        {
          "path": "registry/token-selector/components/token-selector/dune-provider.tsx",
          "type": "registry:component",
          "target": "src/components/token-selector/dune-provider.tsx"
        },
        {
          "path": "registry/token-selector/constants/chains.ts",
          "type": "registry:file",
          "target": "src/constants/chains.ts"
        },
        {
          "path": "registry/token-selector/hooks/useDeepMemo.ts",
          "type": "registry:hook"
        },
        {
          "path": "registry/token-selector/hooks/useEvmTokenBalances.ts",
          "type": "registry:hook"
        },
        {
          "path": "registry/token-selector/hooks/useIsomorphicLayoutEffect.ts",
          "type": "registry:hook"
        },
        {
          "path": "registry/token-selector/hooks/useMediaQuery.ts",
          "type": "registry:hook"
        },
        {
          "path": "registry/token-selector/lib/utils/dune-api.ts",
          "type": "registry:lib",
          "target": "src/lib/utils/dune-api.ts"
        },
        {
          "path": "registry/token-selector/lib/utils/format.ts",
          "type": "registry:lib",
          "target": "src/lib/utils/format.ts"
        },
        {
          "path": "registry/token-selector/lib/utils/logo.ts",
          "type": "registry:lib",
          "target": "src/lib/utils/logo.ts"
        },
        {
          "path": "registry/token-selector/lib/types/api.ts",
          "type": "registry:file",
          "target": "src/lib/types/api.ts"
        }
      ]
    },
    {
      "name": "addressqr",
      "type": "registry:block",
      "title": "Address QR",
      "description": "A QR code component for an address",
      "tags": ["qr"],
      "dependencies": ["cuer"],
      "files": [
        {
          "path": "registry/addressqr/addressqr.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "spotlight-input",
      "type": "registry:component",
      "title": "Spotlight Input",
      "description": "An input component with spotlight border",
      "registryDependencies": ["input"],
      "files": [
        {
          "path": "registry/spotlight-input/spotlight-input.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "number-ticker",
      "type": "registry:ui",
      "title": "Animated Number Ticker",
      "description": "An animated number ticker",
      "tags": ["number-ticker"],
      "dependencies": ["motion"],
      "files": [
        {
          "path": "registry/number-ticker/number-ticker.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
